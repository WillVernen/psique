# ============================================
# PsiQuê — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no repositório!

# Django
SECRET_KEY=gere-uma-chave-segura-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SSL (True em produção). Use False só se o antivírus/proxy quebrar o certificado no Python.
SSL_VERIFY=True

# Evolution API (WhatsApp) — opcional
EVOLUTION_API_URL=https://seu-dominio-evolution-api.com
EVOLUTION_API_KEY=sua-chave-aqui
EVOLUTION_INSTANCE_NAME=nome_da_instancia
